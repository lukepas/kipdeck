{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/media/mergeline-demo.gif",
      "destination": "/media/kipdeck-demo.gif",
      "permanent": true
    },
    {
      "source": "/media/mergeline-demo.mp4",
      "destination": "/media/kipdeck-demo.mp4",
      "permanent": true
    },
    {
      "source": "/media/mergeline-demo-30s.webm",
      "destination": "/media/kipdeck-demo-30s.webm",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(fonts|media|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
