# The deploy scripts run under bash, and provision.sh is piped to a Linux server: CRLF breaks both
# (Git for Windows checks text files out with CRLF by default).
*.sh text eol=lf
# The launch calendar is iCalendar, whose lines must end in CRLF (RFC 5545); keep them byte for byte.
launch/chain/calendar.ics -text
launch/calendar.ics -text
# The /rundown script is committed for the Claude Code plugin and compared byte for byte with its build.
plugins/rundown/skills/rundown/scripts/rundown.mjs text eol=lf
